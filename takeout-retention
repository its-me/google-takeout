#!/usr/bin/env bash
set -euo pipefail

DRY_RUN=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run|-n) DRY_RUN=true; shift ;;
    *) echo "Usage: takeout-retention [--dry-run|-n]" >&2; exit 1 ;;
  esac
done

TAKEOUT_RCLONE_UNION_REMOTE_NAME="${TAKEOUT_RCLONE_UNION_REMOTE_NAME:-}"
TAKEOUT_RETENTION_KEEP_LAST="${TAKEOUT_RETENTION_KEEP_LAST:-10}"
TAKEOUT_RETENTION_KEEP_MONTHS="${TAKEOUT_RETENTION_KEEP_MONTHS:-12}"

[[ -z "$TAKEOUT_RCLONE_UNION_REMOTE_NAME" ]] && { echo "Error: TAKEOUT_RCLONE_UNION_REMOTE_NAME is not set" >&2; exit 1; }

[[ "$TAKEOUT_RETENTION_KEEP_LAST" =~ ^[0-9]+$ ]] || { echo "Error: TAKEOUT_RETENTION_KEEP_LAST must be a non-negative integer" >&2; exit 1; }
[[ "$TAKEOUT_RETENTION_KEEP_MONTHS" =~ ^[0-9]+$ ]] || { echo "Error: TAKEOUT_RETENTION_KEEP_MONTHS must be a non-negative integer" >&2; exit 1; }

union="${TAKEOUT_RCLONE_UNION_REMOTE_NAME}:"
cutoff=$(date -d "$(date +%Y-%m-01) -$((10#$TAKEOUT_RETENTION_KEEP_MONTHS)) months" +%Y-%m-%d)

# rclone flags that keep stdout machine-readable even if RCLONE_PROGRESS / RCLONE_STATS
# are set in the environment (progress output would otherwise corrupt the file list).
rclone_quiet=(--progress=false --stats=0)

human() { numfmt --to=iec --suffix=B --format='%.1f' "$1"; }

# Retention rules:
#   1. Always keep files dated within the last $TAKEOUT_RETENTION_KEEP_MONTHS months (on or after $cutoff)
#   2. Always keep the most recent $TAKEOUT_RETENTION_KEEP_LAST files (rules 1+2 overlap)
apply_retention() {
  echo "[INFO] Remote:  $union"
  echo "[INFO] Policy:  keep the $TAKEOUT_RETENTION_KEEP_LAST most recent backup(s)"
  echo "[INFO]          keep every backup dated on or after $cutoff (last $TAKEOUT_RETENTION_KEEP_MONTHS month(s))"
  echo "[INFO]          delete everything else"

  # Each line: <path>;<size in bytes>; newest first by filename date
  local listing
  listing=$(rclone lsf "$union" "${rclone_quiet[@]}" --files-only --max-depth 1 \
              --include "*.tar.xz.age" --format "ps" --separator ";")
  local files=() sizes=()
  local line
  while IFS= read -r line; do
    [[ "$line" =~ ^(.+\.tar\.xz\.age)\;([0-9]+)$ ]] || continue
    files+=("${BASH_REMATCH[1]}")
    sizes+=("${BASH_REMATCH[2]}")
  done < <(sort -r <<<"$listing")

  if [[ ${#files[@]} -eq 0 ]]; then
    echo "[INFO] No backups found"
    return
  fi

  echo "[INFO] Found ${#files[@]} backup(s), newest first:"
  echo ""

  local width=4 f
  for f in "${files[@]}"; do (( ${#f} > width )) && width=${#f}; done

  local fmt="  %3s  %-${width}s  %-10s  %8s  %-6s  %s\n"
  # shellcheck disable=SC2059
  printf "$fmt" "#" "FILE" "DATE" "SIZE" "ACTION" "REASON"

  local i rank=0 kept=0 skipped=0 kept_bytes=0 delete_bytes=0
  local to_delete=() file size date_str action reason reasons
  for i in "${!files[@]}"; do
    file="${files[$i]}"
    size="${sizes[$i]}"
    rank=$((rank + 1))

    if [[ "$file" =~ ([0-9]{4}-[0-9]{2}-[0-9]{2}) ]]; then
      date_str="${BASH_REMATCH[1]}"
    else
      skipped=$((skipped + 1))
      # shellcheck disable=SC2059
      printf "$fmt" "$rank" "$file" "?" "$(human "$size")" "SKIP" "cannot parse date from filename"
      continue
    fi

    reasons=()
    (( rank <= TAKEOUT_RETENTION_KEEP_LAST )) && reasons+=("one of $TAKEOUT_RETENTION_KEEP_LAST most recent")
    [[ ! "$date_str" < "$cutoff" ]] && reasons+=("within $TAKEOUT_RETENTION_KEEP_MONTHS month(s)")

    if (( ${#reasons[@]} > 0 )); then
      action="KEEP"
      reason=$(IFS=','; echo "${reasons[*]}"); reason="${reason//,/, }"
      kept=$((kept + 1))
      kept_bytes=$((kept_bytes + size))
    else
      action="DELETE"
      reason="older than $cutoff and not among $TAKEOUT_RETENTION_KEEP_LAST most recent"
      to_delete+=("$file")
      delete_bytes=$((delete_bytes + size))
    fi
    # shellcheck disable=SC2059
    printf "$fmt" "$rank" "$file" "$date_str" "$(human "$size")" "$action" "$reason"
  done

  echo ""
  echo "[INFO] Keep:    $kept backup(s), $(human "$kept_bytes")"
  echo "[INFO] Delete:  ${#to_delete[@]} backup(s), $(human "$delete_bytes")"
  (( skipped > 0 )) && echo "[WARN] Skipped: $skipped backup(s) with unparseable dates (left untouched)"

  if (( ${#to_delete[@]} == 0 )); then
    echo "[INFO] Nothing to delete"
    return
  fi

  if $DRY_RUN; then
    echo "[INFO] Dry run complete — nothing was deleted"
    return
  fi

  echo ""
  for file in "${to_delete[@]}"; do
    echo "[DELETE] $file"
    rclone deletefile "${rclone_quiet[@]}" "${union}${file}"
  done
  echo "[INFO] Done — ${#to_delete[@]} backup(s) deleted, $(human "$delete_bytes") freed"
}

$DRY_RUN && echo "[INFO] Dry run — no files will be deleted"
apply_retention
